# 大学サークル恋愛ADV・最小動作試作
# Requires a project generated by Ren'Py Launcher.
# All characters in this prototype are adults; names are placeholders.

define protagonist = Character("主人公", color="#b5d8f5")
define aoi = Character("葵", color="#edb8d1")

default affection_aoi = 0
default campus_visits = 0
default club_visits = 0
default beach_visited_with_aoi = False

# Placeholder art. Replace with image files once approved art is available.
image bg opening = Solid("#1e2842")
image bg campus = Solid("#b6ced9")
image bg clubroom = Solid("#dacbbd")
image bg beach = Solid("#a4d8ec")
image aoi neutral = Solid("#e2bccc", xysize=(300, 480))

label start:
    scene bg opening with fade
    "四月。新しい学期が始まった。"
    "俺は大学二年生。何か新しいことでも始めようと思っていた。"
    protagonist "サークル、覗いてみるか。"

    scene bg campus with dissolve
    show aoi neutral at right with dissolve
    aoi "こんにちは。サークルの説明、聞いていきませんか？"
    protagonist "ちょうど探してたところなんだ。"
    aoi "私は葵。大学三年生です。気軽に来てくださいね。"
    hide aoi with dissolve

    "大学の周辺には、いくつか立ち寄れる場所がある。"
    jump circle_map_loop

label circle_map_loop:
    call screen circle_map
    if _return == "campus":
        call campus_event
    elif _return == "clubroom":
        call clubroom_event
    elif _return == "beach":
        call beach_event
    else:
        "移動先が選ばれなかった。"
    jump circle_map_loop

label campus_event:
    $ campus_visits += 1
    scene bg campus with dissolve
    "大学のキャンパス。学生たちが行き交っている。"
    show aoi neutral at right with dissolve
    if campus_visits == 1:
        aoi "また会いましたね。部室にも寄ってみてください。"
    else:
        aoi "今日は何か用事ですか？"
    menu:
        "葵と少し話す":
            protagonist "最近、授業はどうですか？"
            aoi "忙しいですけど、サークルが息抜きになってます。"
            $ affection_aoi += 1
        "今日は挨拶だけ":
            protagonist "また今度、ゆっくり話しましょう。"
            aoi "はい、また。"
    hide aoi with dissolve
    return

label clubroom_event:
    $ club_visits += 1
    scene bg clubroom with dissolve
    "サークルの部室。テーブルには活動の資料が広がっている。"
    show aoi neutral at right with dissolve
    aoi "ちょうど準備をしていたところなんです。"
    menu:
        "一緒に準備する":
            protagonist "手伝おうか？"
            aoi "助かります！"
            $ affection_aoi += 1
        "活動について聞く":
            protagonist "ここでは普段、何をしてるんですか？"
            aoi "それは、これから少しずつ紹介しますね。"
    if affection_aoi >= 2:
        aoi "今度、海辺でみんなと集まる話もあるんです。"
    hide aoi with dissolve
    return

label beach_event:
    scene bg beach with dissolve
    "海辺。潮風が気持ちいい。"
    if affection_aoi >= 2:
        show aoi neutral at right with dissolve
        if not beach_visited_with_aoi:
            aoi "来てくれたんですね。今日はのんびりしましょう。"
            protagonist "いい景色だな。"
            $ beach_visited_with_aoi = True
        else:
            aoi "また海に来ましたね。"
        hide aoi with dissolve
    else:
        protagonist "今度は誰かを誘って来たいな。"
    return
