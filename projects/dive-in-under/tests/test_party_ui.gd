extends SceneTree
const E=preload("res://core/expedition.gd")
const Party=preload("res://core/party_ui.gd")
const Gear=preload("res://core/gear_transfer.gd")
const Storage=preload("res://core/storage.gd")
var checks: Array=[]
func check(value: bool, name: String) -> void:
	if not value:push_error("PARTY_FAIL "+name);quit(1);assert(false,name)
	checks.append(name)
func _init() -> void:
	var cfg: Dictionary=E.load_config();var data: Dictionary=E.Adventure.combat_data(preload("res://core/catalog.gd").load_data(),cfg)
	var s: Dictionary=E.fresh(cfg,13)
	Party.add_dummy(s,"B","検証用の仲間",{"max_hp":30,"max_sp":4,"atk":4,"def":2,"spd":8})
	var uid: String=s.equipment.head;var condition: Dictionary=s.item_condition[uid].duplicate(true)
	check(Gear.apply(s,{"slot":"head","destination":"warehouse","cell":8},cfg,true)=="","supply gear can enter exact warehouse cell")
	check(Storage.uid_at(s,8)==uid and s.item_condition[uid]==condition,"warehouse keeps UID and durability")
	check(Gear.apply(s,{"actor":"B","uid":uid,"source":"warehouse"},cfg)=="" and s.companions.B.equipment.head==uid,"warehouse equips selected companion only")
	check(s.equipment.head=="" and Party.actor(s,cfg,"B").def>=2,"hero unchanged companion stats use gear")
	for i in 15:E.add_item(s,"I10")
	var before: Dictionary=s.duplicate(true)
	check(Gear.apply(s,{"actor":"B","slot":"head","destination":"inventory"},cfg,true)!="" and s==before,"full bag removal atomic")
	check(Gear.apply(s,{"actor":"B","slot":"head","destination":"warehouse","cell":18},cfg,true)=="","full bag can remove to warehouse")
	check(Storage.reorder(s,uid,2)=="" and Storage.uid_at(s,2)==uid,"manual warehouse cell preserves identity")
	var incoming: String=E.add_item(s,"A02");s.inventory.erase(incoming);s.warehouse.append(incoming);Storage.ensure_positions(s)
	check(Storage.reorder(s,incoming,2)=="" and Storage.uid_at(s,2)==incoming,"occupied warehouse reorder swaps cells")
	check(Storage.matches(cfg.items.A02,"armor","head") and Storage.matches(cfg.items.A06,"armor","left_hand"),"cloak and shield follow existing slots")
	check(not Storage.matches(cfg.items.A06,"weapon"),"shield not misclassified as weapon")
	s.phase="explore";before=s.duplicate(true)
	check(Gear.apply(s,{"uid":uid,"source":"warehouse"},cfg)!="" and s==before,"dungeon has no remote warehouse access")
	s.phase="town"
	check(E.validate(s,data,cfg)=="","all owners storage and individual data validate")
	var coins: Dictionary=E.fresh(cfg,3);preload("res://core/currency.gd").credit(coins,5)
	var coin: String=coins.inventory[0]
	check(Storage.transfer(coins,{"uid":coin,"source":"inventory","destination":"warehouse","quantity":2,"cell":11},cfg)=="" and coins.quantities[coin]==3,"odd half floors 5 to 2 and leaves 3")
	check(preload("res://core/currency.gd").amount(coins,"warehouse")==2,"partial move conserves all coins")
	coins=E.fresh(cfg,4);preload("res://core/currency.gd").credit(coins,1);coin=coins.inventory[0]
	check(Storage.transfer(coins,{"uid":coin,"source":"inventory","destination":"warehouse","quantity":1},cfg)=="" and coins.inventory.is_empty(),"single coin half moves one")
	DirAccess.make_dir_recursive_absolute("res://artifacts/party-ui")
	var f:=FileAccess.open("res://artifacts/party-ui/core.json",FileAccess.WRITE);f.store_string(JSON.stringify({"complete":true,"checks":checks},"  "));f.close()
	print("PARTY_CORE_OK "+str(checks.size()));quit()
