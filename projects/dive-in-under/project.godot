; Phase 01 solo exploration, persistent progression and normal 10F replay.
config_version=5

[application]
config/name="Dive In Under — 戦闘基盤"
config/version="0.5.4"
run/main_scene="res://ui/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
; Avoid deep Windows cache paths in portable builds and isolated verification.
shader_compiler/shader_cache/enabled=false
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025, 0.05, 0.06, 1)

